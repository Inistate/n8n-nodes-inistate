							"value": "={{ 'Approval needed: ' + $json.documentId }}",
							"type": "string"
						},
						{
							"id": "129d4862-afcc-426c-a229-320ea0ec7142",
							"name": "message",
							"value": "={{ 'Entry ' + String($json.documentId ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]) + ' in ' + String($json.module ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]) + ' is waiting for your approval.\\n\\n' + 'Requested by: ' + String($json.createdBy ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]) + '\\n\\n' + Object.entries($json.data ?? {}).map(([k, v]) => String(k ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]) + ': ' + String((v !== null && typeof v === 'object' ? (v.value ?? JSON.stringify(v)) : v) ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c])).join('\\n') }}",
							"type": "string"
						}
					]
				},
				"options": {}
			},
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [480, -20],
			"name": "Build approval email",
			"id": "26875657-ef9e-4d70-af62-81ebcd4c9ec0"
		},
		{
			"parameters": {
				"resource": "email",
				"operation": "sendAndWait",
				"fromEmail": "={{ $('Settings').item.json.fromEmail }}",
				"toEmail": "={{ $('Settings').item.json.approverEmail }}",
				"subject": "={{ $json.subject }}",
				"message": "={{ $json.message }}",
				"responseType": "approval",
				"approvalOptions": {
					"values": {
						"approvalType": "double",
						"approveLabel": "Approve",
						"disapproveLabel": "Reject"
					}
				},
				"options": {
					"limitWaitTime": {
						"values": {
							"limitType": "afterTimeInterval",
							"resumeAmount": "={{ $('Settings').item.json.waitDays }}",
							"resumeUnit": "days"
						}
					}
				}
			},
			"type": "n8n-nodes-base.emailSend",
